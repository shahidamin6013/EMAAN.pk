# Copy this file to .env and edit the values. Never commit .env to version control.

# --- Core ---
# Generate a key:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed when DEBUG=False behind HTTPS, e.g. https://shop.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database: "sqlite" for simple local use, "postgres" for production ---
DB_ENGINE=sqlite
DB_NAME=emaan_electronics
DB_USER=emaan
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Email (password reset). Default prints emails to the console. ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Emaan Electronics <noreply@example.com>

# --- Production security (used when DJANGO_DEBUG=False) ---
DJANGO_SECURE_SSL_REDIRECT=True

# --- Backups ---
BACKUP_DIR=backups
